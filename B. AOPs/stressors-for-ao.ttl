@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ016 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ016" ;
    rdfs:label "List stressors and their MIEs"@en ;
    rdfs:comment "Returns all stressors and the Molecular Initiating Events they are linked to through AOPs."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:AOPs ;
    schema:keywords "AOP" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:alias "B. AOPs/stressors-for-ao.rq" ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/B.%20AOPs/stressors-for-ao.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>

SELECT DISTINCT ?stressor ?stressorLabel ?mie ?mieLabel
WHERE {
  ?stressor a nci:C54571 ;
    dc:title ?stressorLabel .
  ?aop a aopo:AdverseOutcomePathway ;
    nci:C54571 ?stressor ;
    aopo:has_molecular_initiating_event ?mie .
  ?mie a aopo:KeyEvent ;
    dc:title ?mieLabel .
}
ORDER BY ?stressorLabel""" .
