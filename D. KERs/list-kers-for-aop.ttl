@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ029 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ029" ;
    rdfs:label "List KERs in an AOP"@en ;
    rdfs:comment "Returns all Key Event Relationships in a specific AOP, with the upstream and downstream Key Event titles for each."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-05-24"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:KERs ;
    schema:keywords "key event relationship" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:alias "D. KERs/list-kers-for-aop.rq" ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/D.%20KERs/list-kers-for-aop.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [ a sh:Parameter ; sh:path param:aop_id ;
        snorql:variable "aop" ;
        sh:name "AOP" ; sh:order 1 ;
        sh:defaultValue "12" ;
        sh:nodeKind sh:IRI ; snorql:valueTemplate "https://identifiers.org/aop/{value}" ;
        snorql:autocomplete "aop" ] ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>

SELECT ?KER ?upstreamKE ?upstreamTitle ?downstreamKE ?downstreamTitle
WHERE {
  VALUES ?aop { <https://identifiers.org/aop/12> }
  ?aop aopo:has_key_event_relationship ?KER .
  ?KER aopo:has_upstream_key_event ?upstreamKE ;
       aopo:has_downstream_key_event ?downstreamKE .
  ?upstreamKE dc:title ?upstreamTitle .
  ?downstreamKE dc:title ?downstreamTitle .
}
ORDER BY ?upstreamKE""" .
