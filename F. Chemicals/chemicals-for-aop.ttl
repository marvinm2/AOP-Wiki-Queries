@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ032 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ032" ;
    rdfs:label "List chemicals for AOPs"@en ;
    rdfs:comment "Returns all AOPs with their associated stressor chemicals and CAS registry numbers."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:Chemicals ;
    schema:keywords "chemical" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:alias "F. Chemicals/chemicals-for-aop.rq" ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/F.%20Chemicals/chemicals-for-aop.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [ a sh:Parameter ; sh:path param:aop_id ;
        snorql:variable "aop" ;
        sh:name "AOP (blank = all)" ; sh:order 1 ;
        sh:nodeKind sh:IRI ; snorql:valueTemplate "https://identifiers.org/aop/{value}" ;
        snorql:autocomplete "aop" ] ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX cheminf: <http://semanticscience.org/resource/CHEMINF_>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>

SELECT ?aop ?aoptitle ?CASID ?chemicalname
WHERE {
  # Optional AOP: left blank, ?aop stays unbound and all AOPs are returned.
  VALUES ?aop { UNDEF }
  ?aop a aopo:AdverseOutcomePathway ;
    nci:C54571 ?Stressor ;
    dc:title ?aoptitle .
  ?Stressor aopo:has_chemical_entity ?Chemical .
  ?Chemical cheminf:000446 ?CASID ;
    dc:title ?chemicalname .
}""" .
