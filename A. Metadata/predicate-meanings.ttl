@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ049 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ049" ;
    rdfs:label "What the predicates on AOPs, Key Events and KERs mean"@en ;
    rdfs:comment "Lists every predicate used on AOPs, Key Events or Key Event Relationships with its rdfs:label, rdfs:comment and number of uses. Many predicates are reused ontology terms whose own names are vague (nci:C25664 is Scale in NCIt, but here holds the level of biological organisation); the labels and comments in this endpoint say what AOP-Wiki stores under each. A good first query before writing others."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-11-17"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:Metadata ;
    schema:keywords "schema", "predicate", "label", "vocabulary", "data model" ;
    schema:educationalLevel "beginner" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [ a sh:Parameter ; sh:path param:type ;
        sh:name "Entity type" ; sh:order 1 ;
        sh:defaultValue "AdverseOutcomePathway" ;
        sh:datatype xsd:string ;
        snorql:option [ rdf:value "AdverseOutcomePathway" ; rdfs:label "AOP" ; sh:order 1 ] ;
        snorql:option [ rdf:value "KeyEvent" ; rdfs:label "Key Event" ; sh:order 2 ] ;
        snorql:option [ rdf:value "KeyEventRelationship" ; rdfs:label "Key Event Relationship" ; sh:order 3 ] ] ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?predicate ?label ?comment (COUNT(*) AS ?uses)
WHERE {
  VALUES ?type { "AdverseOutcomePathway" }
  BIND(IRI(CONCAT("http://aopkb.org/aop_ontology#", ?type)) AS ?class)
  ?subject a ?class ;
           ?predicate ?object .
  OPTIONAL { ?predicate rdfs:label ?label }
  OPTIONAL { ?predicate rdfs:comment ?comment }
}
GROUP BY ?predicate ?label ?comment
ORDER BY DESC(?uses)""" .
