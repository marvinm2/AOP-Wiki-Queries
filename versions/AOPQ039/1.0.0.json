 "queryType": "select",
 "query": "PREFIX aopo: <http://aopkb.org/aop_ontology#>\nPREFIX dc: <http://purl.org/dc/elements/1.1/>\n\nSELECT DISTINCT ?aop ?aopLabel ?ao ?aoLabel\nWHERE {\n  ?aop a aopo:AdverseOutcomePathway ;\n    aopo:has_adverse_outcome ?ao ;\n    dc:title ?aopLabel .\n  ?ao dc:title ?aoLabel .\n}\nORDER BY ?aop",
