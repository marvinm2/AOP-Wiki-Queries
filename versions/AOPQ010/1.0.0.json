 ],
 "level": null,
 "target": "https://aopwiki.rdf.bigcat-bioinformatics.org/sparql",
 "federatesWith": [],
 "references": [],
 "derivedFrom": [
  "https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/A.%20Metadata/text-search.rq"
 ],
 "testedAgainst": null,
 "deprecated": false,
 "replacedBy": null,
 "queryType": "select",
 "query": "PREFIX dc: <http://purl.org/dc/elements/1.1/>\n\nSELECT ?item ?name ?predicate ?text\nWHERE {\n  VALUES ?search_term { \"nanotube\" }\n  ?item ?predicate ?text ;\n    dc:title ?name .\n  FILTER regex(?text, ?search_term, \"i\")\n}\nORDER BY DESC(?item)",
 "params": [
  {
   "name": "search_term",
   "variable": "search_term",
   "label": "Search term",
   "description": null,
   "order": 1,
   "kind": "literal",
   "valueTemplate": null,
   "default": "nanotube",
   "optional": false,
   "autocomplete": null,
   "options": null
  }
 ],
 "expect": {
  "minResults": 1
 },
 "path": "A. Metadata/text-search.ttl",
 "aliases": [
  "A. Metadata/text-search.rq"
 ],
