{
 "id": "AOPQ028",
 "iri": "https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ028",
 "label": "Search Key Events by biological level",
 "description": "Returns Key Events with their labels and biological organization levels. Choose a level or leave as All.",
 "version": "1.0.0",
 "created": "2026-03-11",
