 "categories": [
  "https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/KeyEvents"
 ],
 "keywords": [
  "key event"
 ],
 "level": null,
 "target": "https://aopwiki.rdf.bigcat-bioinformatics.org/sparql",
 "federatesWith": [],
 "references": [],
 "derivedFrom": [
  "https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/C.%20Key%20Events/search-ke-by-level.rq"
 ],
 "testedAgainst": null,
 "deprecated": false,
 "replacedBy": null,
 "queryType": "select",
 "query": "PREFIX aopo: <http://aopkb.org/aop_ontology#>\nPREFIX dc: <http://purl.org/dc/elements/1.1/>\nPREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>\n\nSELECT DISTINCT ?ke ?label ?bioLevel\nWHERE {\n  VALUES ?level { \"All\" }\n  ?ke a aopo:KeyEvent ;\n    dc:title ?label ;\n    nci:C25664 ?bioLevel .\n  # \"All\" returns every level.\n  FILTER(?level = \"All\" || ?bioLevel = ?level)\n}\nORDER BY ?bioLevel",
 "params": [
  {
   "name": "level",
   "variable": "level",
   "label": "Biological level",
   "description": null,
   "order": 1,
   "kind": "literal",
   "valueTemplate": null,
   "default": "All",
   "optional": false,
   "autocomplete": null,
   "options": [
    {
     "value": "All",
     "label": "All"
    },
    {
     "value": "Molecular",
     "label": "Molecular"
    },
    {
     "value": "Cellular",
     "label": "Cellular"
    },
    {
     "value": "Tissue",
     "label": "Tissue"
    },
    {
     "value": "Organ",
     "label": "Organ"
    },
    {
     "value": "Individual",
     "label": "Individual"
    },
    {
     "value": "Population",
     "label": "Population"
    }
   ]
  }
 ],
