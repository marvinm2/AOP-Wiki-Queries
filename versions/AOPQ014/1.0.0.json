{
 "id": "AOPQ014",
 "iri": "https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ014",
 "label": "Get AOPs for a specific AO",
 "description": "Returns all Adverse Outcome Pathways that include a specific Adverse Outcome.",
 "version": "1.0.0",
 "created": "2026-03-11",
 "modified": "2026-11-12",
 "creators": [
  {
   "iri": "https://orcid.org/0000-0003-2230-0840",
   "name": "Marvin Martens"
  }
 ],
 "contributors": [],
 "license": "https://www.gnu.org/licenses/gpl-3.0.html",
 "categories": [
  "https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/AOPs"
 ],
 "keywords": [
  "AOP"
 ],
 "level": null,
 "target": "https://aopwiki.rdf.bigcat-bioinformatics.org/sparql",
 "federatesWith": [],
 "references": [],
 "derivedFrom": [
  "https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/B.%20AOPs/get-aop-for-ao.rq"
 ],
 "testedAgainst": null,
 "deprecated": false,
 "replacedBy": null,
 "queryType": "select",
 "query": "PREFIX aopo: <http://aopkb.org/aop_ontology#>\nPREFIX dc: <http://purl.org/dc/elements/1.1/>\n\nSELECT ?AOP ?AOPTitle\nWHERE {\n  VALUES ?AO { <https://identifiers.org/aop.events/1276> }\n  ?AOP a aopo:AdverseOutcomePathway ;\n    dc:title ?AOPTitle ;\n    aopo:has_adverse_outcome ?AO .\n}",
 "params": [
  {
   "name": "ao_id",
   "variable": "AO",
   "label": "AO",
   "description": null,
   "order": 1,
   "kind": "iri",
   "valueTemplate": "https://identifiers.org/aop.events/{value}",
   "default": "1276",
   "optional": false,
   "autocomplete": "keyEvent",
   "options": null
  }
 ],
 "expect": {
  "minResults": 1
 },
 "path": "B. AOPs/get-aop-for-ao.ttl",
 "aliases": [
  "B. AOPs/get-aop-for-ao.rq"
 ],
