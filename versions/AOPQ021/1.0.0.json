 "queryType": "select",
 "query": "PREFIX aopo: <http://aopkb.org/aop_ontology#>\nPREFIX dc: <http://purl.org/dc/elements/1.1/>\n\nSELECT DISTINCT ?ke ?keLabel ?aop ?aopLabel\nWHERE {\n  ?aop a aopo:AdverseOutcomePathway ;\n    aopo:has_key_event ?ke ;\n    dc:title ?aopLabel .\n  ?ke dc:title ?keLabel .\n}\nORDER BY ?keLabel",
