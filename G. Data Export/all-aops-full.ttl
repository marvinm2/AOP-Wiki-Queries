@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ034 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ034" ;
    rdfs:label "Export all AOPs with full details"@en ;
    rdfs:comment "Returns all AOPs with their status, MIEs, Adverse Outcomes, stressors, and number of Key Events."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:DataExport ;
    schema:keywords "export" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:alias "G. Data Export/all-aops-full.rq" ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/G.%20Data%20Export/all-aops-full.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>

SELECT DISTINCT ?aop ?aopTitle ?status
  (GROUP_CONCAT(DISTINCT ?mieTitle; separator=", ") AS ?MIEs)
  (GROUP_CONCAT(DISTINCT ?aoTitle; separator=", ") AS ?AOs)
  (GROUP_CONCAT(DISTINCT ?stressorTitle; separator=", ") AS ?Stressors)
  (COUNT(DISTINCT ?ke) AS ?numKEs)
WHERE {
  ?aop a aopo:AdverseOutcomePathway ;
    dc:title ?aopTitle .
  OPTIONAL { ?aop nci:C25688 ?status . }
  OPTIONAL {
    ?aop aopo:has_molecular_initiating_event ?mie .
    ?mie dc:title ?mieTitle .
  }
  OPTIONAL {
    ?aop aopo:has_adverse_outcome ?ao .
    ?ao dc:title ?aoTitle .
  }
  OPTIONAL {
    ?aop nci:C54571 ?stressor .
    ?stressor dc:title ?stressorTitle .
  }
  OPTIONAL {
    ?aop aopo:has_key_event ?ke .
  }
}
GROUP BY ?aop ?aopTitle ?status
ORDER BY ?aopTitle""" .
