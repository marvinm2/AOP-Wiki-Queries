@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ041 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ041" ;
    rdfs:label "Find applicable species in taxonomic tree"@en ;
    rdfs:comment "Queries the UniProt taxonomy to find all species under a given taxon that have Key Events or Key Event Relationships in the AOP-Wiki."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:Federated ;
    schema:keywords "federated" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    spex:federatesWith <http://sparql.uniprot.org/sparql/> ;
    snorql:alias "H. Federated/applicable-to-taxon-tree.rq" ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/H.%20Federated/applicable-to-taxon-tree.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [ a sh:Parameter ; sh:path param:taxon_id ;
        snorql:variable "taxonGroup" ;
        sh:name "NCBI Taxon ID" ; sh:order 1 ;
        sh:defaultValue "39107" ;
        sh:nodeKind sh:IRI ; snorql:valueTemplate "http://purl.uniprot.org/taxonomy/{value}" ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ncbitaxon: <http://purl.bioontology.org/ontology/NCBITAXON/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?tax
  (GROUP_CONCAT(DISTINCT ?name; separator=" | ") AS ?names)
  (COUNT(DISTINCT ?keker) AS ?n)
WHERE {
  ?keker ncbitaxon:131567 ?taxon2 .
  ?taxon2 a ncbitaxon:131567 ;
    dc:title ?name .
  BIND(SUBSTR(STR(?taxon2), 48) AS ?tax2)
  SERVICE <http://sparql.uniprot.org/sparql/> {
    VALUES ?taxonGroup { <http://purl.uniprot.org/taxonomy/39107> }
    ?taxon rdfs:subClassOf* ?taxonGroup .
  }
  BIND(SUBSTR(STR(?taxon), 34) AS ?tax)
  FILTER (?tax = ?tax2)
}
ORDER BY DESC(?n)""" .
