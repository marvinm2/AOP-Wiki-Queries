# title: List Key Events with annotated UniProt IDs
# category: Key Events
# description: Returns Key Events with their annotated protein objects and linked UniProt identifiers, through AOP membership.
#
# AOPQ026 version 1.0.0, https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ026
# Generated from C. Key Events/kes-and-uniprot-annotated.ttl in marvinm2/AOP-Wiki-Queries at b61004db0307; edit the .ttl file, not this one.

PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX edam: <http://edamontology.org/>
PREFIX pato: <http://purl.obolibrary.org/obo/PATO_>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?keid ?ketitle ?objectname ?uniprotID ?uniprot
WHERE {
  ?aop a aopo:AdverseOutcomePathway ;
    rdfs:label ?aop_id ;
    aopo:has_key_event ?ke .
  ?ke pato:0001241 ?object ;
    dc:title ?ketitle ;
    rdfs:label ?keid .
  ?object dc:title ?objectname ;
    skos:exactMatch ?uniprot .
  ?uniprot a edam:data_2291 ;
    edam:data_2291 ?uniprotID .
}
