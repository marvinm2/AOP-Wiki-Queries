# title: Get dataset metadata
# category: Metadata
# description: Returns the VoID dataset description and creation date for the AOP-Wiki RDF dataset.
#
# AOPQ009 version 1.0.0, https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ009
# Generated from A. Metadata/dataset-metadata.ttl in marvinm2/AOP-Wiki-Queries at b61004db0307; edit the .ttl file, not this one.

PREFIX pav: <http://purl.org/pav/>
PREFIX void: <http://rdfs.org/ns/void#>

SELECT DISTINCT ?dataset ?date
WHERE {
  ?dataset a void:Dataset ;
    pav:createdOn ?date .
}
