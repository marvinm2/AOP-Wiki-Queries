# title: Count predicates using AOP ontology
# category: Metadata
# description: Returns the number of RDF predicates that reference the AOP ontology namespace.
#
# AOPQ006 version 1.0.0, https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ006
# Generated from A. Metadata/count-predicates-aop-ontology.ttl in marvinm2/AOP-Wiki-Queries at b61004db0307; edit the .ttl file, not this one.

SELECT (COUNT(?p) AS ?Predicates)
WHERE {
  ?s ?p ?o .
  FILTER regex(?p, "http://aopkb.org/aop_ontology#")
}
