# title: Find stressors for an adverse outcome
# category: Stressors
# description: Searches for Adverse Outcomes by name and returns linked AOPs, MIEs, stressors, and chemical annotations.
# param: ao_name|autocomplete:keyEvent|fibrosis|Adverse outcome: pick one, or type part of a name
#
# AOPQ030 version 1.0.0, https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ030
# Generated from E. Stressors/stressors-for-ao-searched.ttl in marvinm2/AOP-Wiki-Queries at b61004db0307; edit the .ttl file, not this one.

PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>

SELECT ?AO ?AOname ?AOP ?MIETitle
  (CONCAT('"', GROUP_CONCAT(?StressorName; SEPARATOR='","'), '"') AS ?StressorNames)
  (CONCAT('"', GROUP_CONCAT(?ChemicalName; SEPARATOR='","'), '"') AS ?ChemicalNames)
WHERE {
  VALUES ?ao_name { "{{ao_name}}" }
  ?AO a aopo:KeyEvent ;
    dc:identifier ?AOLookup ;
    dc:title ?AOname .
  ?AOP a aopo:AdverseOutcomePathway ;
    aopo:has_adverse_outcome ?AOLookup ;
    aopo:has_molecular_initiating_event ?MIE ;
    nci:C54571 ?Stressor .
  ?MIE dc:title ?MIETitle .
  ?Stressor dc:title ?StressorName .
  OPTIONAL {
    ?Stressor aopo:has_chemical_entity ?Chemical .
    ?Chemical dc:title ?ChemicalName .
  }
  # A picked Key Event gives its numeric id, matched exactly; any other text is a
  # case-insensitive substring of the adverse outcome name.
  FILTER(IF(regex(?ao_name, "^[0-9]+$"),
    STR(?AO) = CONCAT("https://identifiers.org/aop.events/", ?ao_name),
    regex(?AOname, ?ao_name, "i")))
}
GROUP BY ?AO ?AOname ?AOP ?MIETitle
ORDER BY DESC(?AO)
