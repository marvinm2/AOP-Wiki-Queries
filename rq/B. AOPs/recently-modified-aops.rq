# title: Most recently modified AOPs
# category: AOPs
# description: Lists the 25 AOPs modified most recently in AOP-Wiki, with their creation and modification timestamps. dcterms:created and dcterms:modified are xsd:dateTime values, so ORDER BY, MAX and comparisons such as FILTER(?modified >= "2026-01-01T00:00:00"^^xsd:dateTime) work on them directly.
#
# AOPQ045 version 1.0.0, https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ045
# Generated from B. AOPs/recently-modified-aops.ttl in marvinm2/AOP-Wiki-Queries at a5ff42ecefa8; edit the .ttl file, not this one.

PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?aop ?title ?created ?modified
WHERE {
  ?aop a aopo:AdverseOutcomePathway ;
       dc:title ?title ;
       dcterms:created ?created ;
       dcterms:modified ?modified .
}
ORDER BY DESC(?modified)
LIMIT 25
