# title: Find AOPs applicable to a taxonomic group (e.g. mammals)
# category: Federated
# description: Expands a higher NCBI taxon (default 40674 = Mammalia) into all its descendant species via the UniProt taxonomy, then returns every AOP whose taxonomic applicability falls within that group. The taxa come from UniProt.
# param: taxon_id|string|40674|NCBI Taxon ID (40674 = Mammalia)
#
# AOPQ040 version 1.0.0, https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ040
# Generated from H. Federated/aops-for-taxon.ttl in marvinm2/AOP-Wiki-Queries at b61004db0307; edit the .ttl file, not this one.

PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ncbitaxon: <http://purl.bioontology.org/ontology/NCBITAXON/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX up: <http://purl.uniprot.org/core/>

SELECT ?aop ?aopTitle
  (GROUP_CONCAT(DISTINCT ?species; separator=" | ") AS ?mammalianSpecies)
WHERE {
  # Fetch the taxa in the group from UniProt once, as AOP-Wiki taxon IRIs, then join
  # locally on the IRI.
  SERVICE <https://sparql.uniprot.org/sparql> {
    VALUES ?taxonGroup { <http://purl.uniprot.org/taxonomy/{{taxon_id}}> }
    # The group and everything under it. UniProt stores every ancestor of a taxon, so no
    # property path is needed (Virtuoso is slow to federate a path with a variable).
    { ?taxon rdfs:subClassOf ?taxonGroup }
    UNION
    { ?taxonGroup a up:Taxon . BIND(?taxonGroup AS ?taxon) }
    BIND(IRI(CONCAT("http://purl.bioontology.org/ontology/NCBITAXON/", STRAFTER(STR(?taxon), "taxonomy/"))) AS ?taxon2)
  }
  ?aop a aopo:AdverseOutcomePathway ;
       dc:title ?aopTitle ;
       ncbitaxon:131567 ?taxon2 .
  ?taxon2 a ncbitaxon:131567 ;
          dc:title ?species .
}
GROUP BY ?aop ?aopTitle
ORDER BY ?aopTitle
