@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples> a schema:Dataset,
        snorql:ExampleCollection ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    void:uriSpace "https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/" ;
    schema:codeRepository <https://github.com/marvinm2/AOP-Wiki-Queries> ;
    schema:description "Example SPARQL queries for the AOP-Wiki RDF SPARQL endpoint, shown in the query editor at https://aopwiki.rdf.bigcat-bioinformatics.org/."@en ;
    schema:name "AOP-Wiki SPARQL examples" ;
    schema:url <https://aopwiki.rdf.bigcat-bioinformatics.org/> ;
    snorql:identifierPrefix "AOPQ" .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ001> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count AOPs"@en ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:identifier "AOPQ001" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/Metadata> ;
    rdfs:comment "Returns the total number of Adverse Outcome Pathways in the dataset."@en ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/A.%20Metadata/count-aops.rq> ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>

SELECT (COUNT(DISTINCT ?aop) AS ?total_AOPs)
WHERE {
  ?aop a aopo:AdverseOutcomePathway .
}""" ;
    schema:keywords "metadata" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "A. Metadata/count-aops.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ002> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count all entities"@en ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:identifier "AOPQ002" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/Metadata> ;
    rdfs:comment "Returns the total number of AOPs, Key Events, Key Event Relationships, and Stressors in the AOP-Wiki RDF."@en ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/A.%20Metadata/count-entities.rq> ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>

SELECT ?total_AOPs ?total_KEs ?total_KERs ?total_Stressors
WHERE {
  # One count per subquery: counting all four in one pattern multiplies them.
  { SELECT (COUNT(DISTINCT ?aop) AS ?total_AOPs) WHERE { ?aop a aopo:AdverseOutcomePathway . } }
  { SELECT (COUNT(DISTINCT ?ke) AS ?total_KEs) WHERE { ?ke a aopo:KeyEvent . } }
  { SELECT (COUNT(DISTINCT ?ker) AS ?total_KERs) WHERE { ?ker a aopo:KeyEventRelationship . } }
  { SELECT (COUNT(DISTINCT ?stressor) AS ?total_Stressors) WHERE { ?stressor a nci:C54571 . } }
}""" ;
    schema:keywords "metadata" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "A. Metadata/count-entities.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ003> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count Key Event Relationships"@en ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:identifier "AOPQ003" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/Metadata> ;
    rdfs:comment "Returns the total number of Key Event Relationships in the dataset."@en ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/A.%20Metadata/count-kers.rq> ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>

SELECT (COUNT(DISTINCT ?ker) AS ?total_KERs)
WHERE {
  ?ker a aopo:KeyEventRelationship .
}""" ;
    schema:keywords "metadata" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "A. Metadata/count-kers.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ004> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count Key Events"@en ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
