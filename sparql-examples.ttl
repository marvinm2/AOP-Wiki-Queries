<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ005> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count objects using AOP ontology"@en ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:identifier "AOPQ005" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/Metadata> ;
    rdfs:comment "Returns the number of RDF objects that reference the AOP ontology namespace."@en ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/A.%20Metadata/count-objects-aop-ontology.rq> ;
    sh:select """SELECT (COUNT(?o) AS ?Objects)
WHERE {
  ?s ?p ?o .
  FILTER regex(?o, "http://aopkb.org/aop_ontology#")
}""" ;
    schema:keywords "metadata" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "A. Metadata/count-objects-aop-ontology.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ006> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count predicates using AOP ontology"@en ;
