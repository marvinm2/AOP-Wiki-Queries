    sh:select """SELECT (COUNT(?p) AS ?Predicates)
WHERE {
  ?s ?p ?o .
  FILTER regex(?p, "http://aopkb.org/aop_ontology#")
}""" ;
    schema:keywords "metadata" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "A. Metadata/count-predicates-aop-ontology.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/AOPQ007> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Count stressors"@en ;
