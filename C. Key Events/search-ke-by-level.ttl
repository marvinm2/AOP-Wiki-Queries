@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ028 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ028" ;
    rdfs:label "Search Key Events by biological level"@en ;
    rdfs:comment "Returns Key Events with their labels and biological organization levels. Choose a level or leave as All."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-11"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:KeyEvents ;
    schema:keywords "key event" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:alias "C. Key Events/search-ke-by-level.rq" ;
    prov:wasDerivedFrom <https://github.com/marvinm2/AOP-Wiki-Queries/blob/8812ee8cc5216a5a07bddcdeddbf400339a76d37/C.%20Key%20Events/search-ke-by-level.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [ a sh:Parameter ; sh:path param:level ;
        sh:name "Biological level" ; sh:order 1 ;
        sh:defaultValue "All" ;
        sh:datatype xsd:string ;
        snorql:option [ rdf:value "All" ; rdfs:label "All" ; sh:order 1 ] ;
        snorql:option [ rdf:value "Molecular" ; rdfs:label "Molecular" ; sh:order 2 ] ;
        snorql:option [ rdf:value "Cellular" ; rdfs:label "Cellular" ; sh:order 3 ] ;
        snorql:option [ rdf:value "Tissue" ; rdfs:label "Tissue" ; sh:order 4 ] ;
        snorql:option [ rdf:value "Organ" ; rdfs:label "Organ" ; sh:order 5 ] ;
        snorql:option [ rdf:value "Individual" ; rdfs:label "Individual" ; sh:order 6 ] ;
        snorql:option [ rdf:value "Population" ; rdfs:label "Population" ; sh:order 7 ] ] ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX nci: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>

SELECT DISTINCT ?ke ?label ?bioLevel
WHERE {
  VALUES ?level { "All" }
  ?ke a aopo:KeyEvent ;
    dc:title ?label ;
    nci:C25664 ?bioLevel .
  # "All" returns every level.
  FILTER(?level = "All" || ?bioLevel = ?level)
}
ORDER BY ?bioLevel""" .
