@prefix aopcat: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/category/> .
@prefix aopq: <https://aopwiki.rdf.bigcat-bioinformatics.org/.well-known/sparql-examples/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aopq:AOPQ046 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "AOPQ046" ;
    rdfs:label "Key Events of an AOP with their role"@en ;
    rdfs:comment "Lists every Key Event of an AOP once, with its role in that AOP: MIE (molecular initiating event), AO (adverse outcome) or KE. aopo:has_key_event already includes the MIEs and AOs, so counting aopo:has_key_event, aopo:has_molecular_initiating_event and aopo:has_adverse_outcome together counts them twice. The role belongs to the AOP, not the Key Event: the same Key Event can be an MIE in one AOP and an intermediate KE in another."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-11-17"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject aopcat:KeyEvents, aopcat:AOPs ;
    schema:keywords "key event", "MIE", "adverse outcome", "role" ;
    schema:educationalLevel "beginner" ;
    schema:target <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [ a sh:Parameter ; sh:path param:aop_id ;
        snorql:variable "aop" ;
        sh:name "AOP" ; sh:order 1 ;
        sh:defaultValue "12" ;
        sh:nodeKind sh:IRI ; snorql:valueTemplate "https://identifiers.org/aop/{value}" ;
        snorql:autocomplete "aop" ] ;
    sh:select """PREFIX aopo: <http://aopkb.org/aop_ontology#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>

SELECT ?ke ?title ?role
WHERE {
  VALUES ?aop { <https://identifiers.org/aop/12> }
  ?aop aopo:has_key_event ?ke .
  ?ke dc:title ?title .
  BIND(IF(EXISTS { ?aop aopo:has_molecular_initiating_event ?ke }, "MIE",
       IF(EXISTS { ?aop aopo:has_adverse_outcome ?ke }, "AO", "KE")) AS ?role)
}
ORDER BY ?role ?title""" .
